// One delivery received at a branch: what came in, from whom, under which
// supplier document (DR / invoice), and who received it. The lines stay as a
// record even after their batches are sold out or discarded.
model Receiving {
  id              String          @id @default(cuid())
  tenantId        String
  storeId         String
  supplierId      String?
  receivingNumber String // RCV-yyyymmdd-0001, assigned by Nookly
  referenceNumber String? // the supplier's DR / invoice number
  receivedAt      DateTime        @default(now())
  notes           String?
  totalCost       Decimal         @db.Decimal(12, 2)
  receivedById    String
  createdAt       DateTime        @default(now())
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receivedBy      User            @relation("ReceivingReceivedBy", fields: [receivedById], references: [id])
  items           ReceivingItem[]

  @@unique([tenantId, receivingNumber])
  @@index([tenantId, storeId, receivedAt])
  @@index([supplierId])
  @@map("receivings")
}

model ReceivingItem {
  id             String        @id @default(cuid())
  receivingId    String
  productId      String
  // The batch the units went into; kept even if that batch is later emptied.
  batchId        String?
  batchNumber    String
  expirationDate DateTime
  quantity       Int
  unitCost       Decimal       @db.Decimal(10, 2)
  receiving      Receiving     @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch          ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([receivingId])
  @@index([productId])
  @@map("receiving_items")
}

// Discounts the counter can apply, set up per workspace in Settings.
// Senior citizen and PWD are fixed by law (20%, VAT-exempt) and can't be edited.
model Discount {
  id        String    @id @default(cuid())
  tenantId  String
  code      String // short label stored on sales: SENIOR, PWD, or derived from the name
  name      String
  kind      String    @default("PERCENT") // PERCENT or FIXED
  value     Decimal   @db.Decimal(10, 2) // percent (0-100) or peso amount
  maxAmount Decimal?  @db.Decimal(10, 2) // optional cap on the peso discount
  vatExempt Boolean   @default(false) // remove VAT first, then discount (SC/PWD rule)
  asksForId Boolean   @default(false) // show ID number and holder name at checkout
  isSystem  Boolean   @default(false)
  isActive  Boolean   @default(true)
  startsOn  DateTime? // first day it can be used (inclusive), Philippine date
  endsOn    DateTime? // last day it can be used (inclusive)
  storeIds  String[]  @default([]) // branches that offer it; empty = every branch
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@unique([tenantId, code])
  @@map("discounts")
}

// A cart put on hold at the POS so the counter can serve the next customer,
// then loaded back later. Prices and stock are re-read when it's loaded.
model HeldCart {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  userId    String
  label     String? // customer name or a note, to tell held carts apart
  items     Json // [{ productId, quantity }]
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation("HeldCartUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId, createdAt])
  @@map("held_carts")
}
