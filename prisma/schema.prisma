generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PLATFORM / BILLING
// Every operational model below carries a tenantId — this is what makes
// Nookly multi-tenant on a single shared database.
// ---------------------------------------------------------------------------

model Plan {
  id                   String              @id @default(cuid())
  code                 PlanCode            @unique
  name                 String
  tagline              String?
  priceMonthly         Decimal             @db.Decimal(10, 2)
  priceYearly          Decimal             @db.Decimal(10, 2)
  maxStores            Int // -1 = unlimited
  maxUsers             Int // -1 = unlimited
  maxProducts          Int // -1 = unlimited
  features             Json // list of feature strings shown on pricing page
  // Which Reports tabs this plan can see — a JSON array of report keys (see
  // ReportKey in src/lib/plan-gating.ts), e.g. ["overview","inventory-dates"].
  // Replaces a single on/off "Reports" flag so a plan can offer some report
  // tabs without all of them (e.g. expiry monitor on Sprout, full financials
  // reserved for Bloom+).
  enabledReports       Json                @default("[]")
  featurePrescriptions Boolean             @default(false)
  featureAlerts        Boolean             @default(false)
  featureMultiBranch   Boolean             @default(false)
  featureApiAccess     Boolean             @default(false)
  isActive             Boolean             @default(true)
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  subscriptions        Subscription[]
  requestsFrom         PlanChangeRequest[] @relation("CurrentPlanRequests")
  requestsTo           PlanChangeRequest[] @relation("RequestedPlanRequests")

  @@map("plans")
}

// A tenant-generated credential for the read-only public API (gated behind
// featureApiAccess). Only the sha256 hash is stored — the raw key is shown
// once at creation time, same pattern as password reset tokens.
model ApiKey {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  keyPrefix       String // first chars of the raw key, shown in the UI so a tenant can tell keys apart without re-revealing them
  keyHash         String    @unique
  createdByUserId String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

// One row per committed spreadsheet import in "add new products" mode — the
// only mode simple enough to safely undo (nothing to revert on existing
// products). Tags every product it created so an accidental/wrong-file
// import can be undone in one click, as long as none of its products have
// been sold yet.
model ImportBatch {
  id        String    @id @default(cuid())
  tenantId  String
  storeId   String
  userId    String
  fileName  String?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId])
  @@map("import_batches")
}

model Tenant {
  id                   String                    @id @default(cuid())
  name                 String // Drugstore / business name shown on receipts
  slug                 String                    @unique // used for subdomain / login routing e.g. mercury-drug
  ownerEmail           String
  contactNumber        String?
  timezone             String                    @default("Asia/Manila")
  currency             String                    @default("PHP")
  isActive             Boolean                   @default(true)
  onboardingStep       Int                       @default(0) // drives setup wizard progress
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  subscription         Subscription?
  stores               Store[]
  users                User[]
  customers            Customer[]
  categories           Category[]
  suppliers            Supplier[]
  products             Product[]
  doctors              Doctor[]
  prescriptions        Prescription[]
  sales                Sale[]
  stockMovements       StockMovement[]
  receiptSettings      ReceiptSettings?
  notificationSettings NotificationSettings?
  scheduledReports     ScheduledReportDelivery[]
  apiKeys              ApiKey[]
  importBatches        ImportBatch[]
  supportTickets       SupportTicket[]
  shifts               Shift[]
  cashTransactions     CashTransaction[]
  invites              TenantInvite[]
  planChangeRequests   PlanChangeRequest[]
  rolePermissions      RolePermission[]
  shiftExpenses        ShiftExpense[]
  pendingOrders        PendingOrder[]
  stockRequests        StockRequest[]
  receivings           Receiving[]
  discounts            Discount[]
  heldCarts            HeldCart[]

  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  // Free account granted by Nookly (family, internal/test workspaces) — has full
  // plan access but is never counted as paying in MRR/revenue/conversion.
  isComplimentary    Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  invoices           Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("PHP")
  status         InvoiceStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  externalRef    String? // gateway (PayMongo/Stripe) reference id
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model TenantInvite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       UserRole  @default(CASHIER)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("tenant_invites")
}

// Per-tenant override of what each staff role can access, set by the owner
// from Settings > User Access. A missing row for a given (tenantId, role,
// module) means "use the built-in default" (see src/lib/permissions.ts), so
// every tenant behaves exactly like the old hardcoded role checks until the
// owner actually customizes something.
model RolePermission {
  id        String   @id @default(cuid())
  tenantId  String
  role      UserRole
  module    String
  allowed   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, module])
  @@index([tenantId])
  @@map("role_permissions")
}

// Append-only trail of every sensitive action taken in the platform ops console.
// Intentionally has no FK to User — must survive regardless of user lifecycle.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_logs")
}

// A tenant-reported issue/question, threaded like a mail conversation between
// the tenant and platform admins (Outlook-style inbox on the admin side).
model SupportTicket {
  id              String                 @id @default(cuid())
  tenantId        String
  subject         String
  status          SupportTicketStatus    @default(OPEN)
  priority        SupportTicketPriority  @default(NORMAL)
  createdByUserId String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser   User                   @relation(fields: [createdByUserId], references: [id])
  messages        SupportTicketMessage[]

  @@index([tenantId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String            @id @default(cuid())
  ticketId     String
  authorType   SupportAuthorType
  authorUserId String?
  authorEmail  String
  body         String
  attachments  String[]          @default([])
  createdAt    DateTime          @default(now())
  ticket       SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser   User?             @relation(fields: [authorUserId], references: [id])

  @@map("support_ticket_messages")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportAuthorType {
  TENANT
  ADMIN
}

// A tenant-initiated request to switch plans. Nookly does not collect payment
// automatically — the flow is: tenant requests -> we contact them -> they pay
// out of band -> we confirm and activate the new plan (sets Subscription.planId).
model PlanChangeRequest {
  id                String                  @id @default(cuid())
  tenantId          String
  currentPlanId     String
  requestedPlanId   String
  billingCycle      BillingCycle            @default(MONTHLY)
  note              String?
  status            PlanChangeRequestStatus @default(PENDING)
  requestedByUserId String
  resolvedNote      String?
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentPlan       Plan                    @relation("CurrentPlanRequests", fields: [currentPlanId], references: [id])
  requestedPlan     Plan                    @relation("RequestedPlanRequests", fields: [requestedPlanId], references: [id])
  requestedByUser   User                    @relation(fields: [requestedByUserId], references: [id])

  @@index([tenantId, status])
  @@map("plan_change_requests")
}

model Store {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  code             String
  address          String?
  city             String?
  isActive         Boolean           @default(true)
  isMainBranch     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            User[]
  productStocks    ProductStock[]
  sales            Sale[]
  stockMovements   StockMovement[]
  shifts           Shift[]
  cashTransactions CashTransaction[]
  pendingOrders    PendingOrder[]
  batches          ProductBatch[]
  stockRequestsIn  StockRequest[]    @relation("StockRequestTo")
  stockRequestsOut StockRequest[]    @relation("StockRequestFrom")
  receivings       Receiving[]
  heldCarts        HeldCart[]

  @@unique([tenantId, code])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// STORE OPERATIONS (mirrors gfp-pos, scoped by tenantId / storeId)
// ---------------------------------------------------------------------------

model User {
  id                    String                 @id @default(cuid())
  tenantId              String
  storeId               String?
  email                 String
  username              String                 @unique
  password              String
  firstName             String
  lastName              String
  role                  UserRole               @default(CASHIER)
  hasSeenTour           Boolean                @default(false) // drives the first-time-user guided tour
  isActive              Boolean                @default(true)
  isPlatformAdmin       Boolean                @default(false) // grants access to the platform ops console, independent of tenant role
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                 Store?                 @relation(fields: [storeId], references: [id])
  sales                 Sale[]                 @relation("SaleCashier")
  ordersTaken           Sale[]                 @relation("SaleOrderTaker")
  pendingOrders         PendingOrder[]
  stockRequestsMade     StockRequest[]         @relation("StockRequestRequestedBy")
  stockRequestsHandled  StockRequest[]         @relation("StockRequestHandledBy")
  stockMovements        StockMovement[]
  planChangeRequests    PlanChangeRequest[]
  supportTickets        SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  shifts                Shift[]
  cashTransactions      CashTransaction[]
  passwordResetTokens   PasswordResetToken[]
  apiKeys               ApiKey[]
  receivings            Receiving[]            @relation("ReceivingReceivedBy")
  heldCarts             HeldCart[]             @relation("HeldCartUser")

  @@unique([tenantId, email])
  @@map("users")
}

// Single-use, time-limited password reset tokens. Only a SHA-256 hash of the
// raw token is stored — the raw value only ever exists in the emailed link —
// so a database leak alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Records every FAILED login attempt so brute-force/credential-stuffing can be
// throttled — keyed both by the specific account targeted and by source IP,
// independent of whether that account (or even the workspace) actually exists.
model LoginAttempt {
  id             String   @id @default(cuid())
  accountKeyHash String
  ip             String?
  createdAt      DateTime @default(now())

  @@index([accountKeyHash, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Customer {
  id               String         @id @default(cuid())
  tenantId         String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  dateOfBirth      DateTime?
  gender           Gender?
  insuranceCarrier String?
  insuranceId      String?
  insuranceGroup   String?
  allergies        String?
  medicalNotes     String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  loyaltyPoints    Int            @default(0)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptions    Prescription[]
  sales            Sale[]

  @@index([tenantId])
  @@map("customers")
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Supplier {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products      ProductSupplier[]
  batches       ProductBatch[]
  receivings    Receiving[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

model ReceiptSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  storeName           String   @default("My Drugstore")
  receiptTitle        String   @default("Acknowledgement Receipt (AR)")
  addressLine1        String   @default("Complete Address Here")
  addressLine2        String?
  contactNumber       String?
  tin                 String?
  permitNumber        String?
  accreditationNumber String?
  serialNumberLabel   String?
  footerMessage       String   @default("Thank you for your purchase!")
  showVatBreakdown    Boolean  @default(true)
  showCashierName     Boolean  @default(true)
  showCustomerName    Boolean  @default(true)
  includeOrderRemarks Boolean  @default(true)
  logoUrl             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("receipt_settings")
}

model NotificationSettings {
  id                             String   @id @default(cuid())
  tenantId                       String   @unique
  emailNotificationsEnabled      Boolean  @default(true)
  saleNotificationsEnabled       Boolean  @default(true)
  lowStockNotificationsEnabled   Boolean  @default(true)
  outOfStockNotificationsEnabled Boolean  @default(true)
  endOfDaySummaryEnabled         Boolean  @default(false)
  monthlySummaryEnabled          Boolean  @default(false)
  alertRecipientEmails           String? // comma separated
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  tenant                         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model ScheduledReportDelivery {
  id         String              @id @default(cuid())
  tenantId   String
  reportType ScheduledReportType
  periodKey  String
  sentAt     DateTime            @default(now())
  createdAt  DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportType, periodKey])
  @@map("scheduled_report_deliveries")
}

model Product {
  id                   String             @id @default(cuid())
  tenantId             String
  name                 String
  genericName          String?
  brandName            String?
  barcode              String?
  ndcNumber            String?
  description          String?
  strength             String?
  dosageForm           String?
  manufacturer         String?
  classification       String?
  therapeuticUse       String?
  costPrice            Decimal            @db.Decimal(10, 2)
  costPricePerBox      Decimal?           @db.Decimal(10, 2)
  sellingPrice         Decimal            @db.Decimal(10, 2)
  insurancePrice       Decimal?           @db.Decimal(10, 2)
  minimumStock         Int                @default(0)
  maximumStock         Int?
  reorderPoint         Int                @default(0)
  drugSchedule         DrugSchedule?
  requiresPrescription Boolean            @default(false)
  isOTC                Boolean            @default(true)
  isVatable            Boolean            @default(true)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  categoryId           String
  imageUrl             String?
  productType          String? // 'pharmacy' | 'general'
  sku                  String?
  weight               Float?
  dimensions           String?
  color                String?
  size                 String?
  material             String?
  expiryDate           DateTime?
  // Set only for products created by a spreadsheet import — lets that import
  // be undone (see ImportBatch) while it's still safe to (nothing sold yet).
  importBatchId        String?
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptionItems    PrescriptionItem[]
  batches              ProductBatch[]
  suppliers            ProductSupplier[]
  category             Category           @relation(fields: [categoryId], references: [id])
  saleItems            SaleItem[]
  stockMovements       StockMovement[]
  stocks               ProductStock[]
  importBatch          ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  receivingItems       ReceivingItem[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, ndcNumber])
  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
  @@map("products")
}

// Per-branch stock level. A single-branch (Sprout) tenant simply has one
// ProductStock row per product tied to its one Store.
model ProductStock {
  id           String   @id @default(cuid())
  productId    String
  storeId      String
  currentStock Int      @default(0)
  // Price at this branch when it differs from the product's own price. Null
  // (the default) means the branch sells at Product.sellingPrice.
  sellingPrice Decimal? @db.Decimal(10, 2)
  // True when this branch doesn't sell the product at all, so it's left out of
  // that branch's POS. Every product is sold everywhere by default.
  isHidden     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("product_stocks")
}

model ProductBatch {
  id             String          @id @default(cuid())
  batchNumber    String
  expirationDate DateTime
  quantity       Int
  costPrice      Decimal         @db.Decimal(10, 2)
  receivedDate   DateTime        @default(now())
  productId      String
  // The branch physically holding this batch. Null only for batches recorded
  // before branches existed — those belong to the tenant's primary branch.
  storeId        String?
  // Who supplied this lot, recorded when it's received. Optional.
  supplierId     String?
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  store          Store?          @relation(fields: [storeId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receivingItems ReceivingItem[]

  @@unique([productId, storeId, batchNumber])
  @@index([storeId])
  @@index([supplierId])
  @@map("product_batches")
}

model ProductSupplier {
  id           String   @id @default(cuid())
  supplierCode String?
  leadTime     Int?
  minimumOrder Int?
  productId    String
  supplierId   String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  storeId   String
  type      StockMovementType
  quantity  Int
  reason    String?
  reference String?
  notes     String?
  createdAt DateTime          @default(now())
  productId String
  userId    String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store             @relation(fields: [storeId], references: [id])
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@index([tenantId, storeId, createdAt])
  @@index([productId])
  @@map("stock_movements")
}

model Doctor {
  id            String         @id @default(cuid())
  tenantId      String
  firstName     String
  lastName      String
  specialty     String?
  licenseNumber String?
  deaNumber     String?
  npiNumber     String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]

  @@unique([tenantId, licenseNumber])
  @@map("doctors")
}

model Prescription {
  id                 String             @id @default(cuid())
  tenantId           String
  prescriptionNumber String
  originalDate       DateTime
  writtenDate        DateTime
  instructions       String?
  refillsAllowed     Int                @default(0)
  refillsUsed        Int                @default(0)
  daysSupply         Int?
  status             PrescriptionStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customerId         String
  doctorId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items              PrescriptionItem[]
  customer           Customer           @relation(fields: [customerId], references: [id])
  doctor             Doctor             @relation(fields: [doctorId], references: [id])
  sales              Sale[]

  @@unique([tenantId, prescriptionNumber])
  @@index([tenantId, status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  quantity       Int // prescribed
  // How many have been dispensed so far; the prescription is partially served
  // until every item reaches its prescribed quantity.
  servedQuantity Int          @default(0)
  instructions   String?
  substituted    Boolean      @default(false)
  prescriptionId String
  productId      String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model Sale {
  id                       String        @id @default(cuid())
  tenantId                 String
  storeId                  String
  saleNumber               String
  subtotal                 Decimal       @db.Decimal(10, 2)
  vatableSales             Decimal?      @db.Decimal(10, 2)
  nonVatableSales          Decimal?      @db.Decimal(10, 2)
  taxAmount                Decimal       @db.Decimal(10, 2)
  discountType             String?       @default("NONE")
  discountAmount           Decimal       @default(0) @db.Decimal(10, 2)
  discountIdNumber         String? // SC/PWD/etc ID number — optional, captured for audit if the cashier has it
  discountHolderName       String? // Name of the SC/PWD ID holder — printed on the signature block for discount sales
  // The discount as it was when the sale was made, so receipts and reprints
  // stay right even if the discount is edited or removed later.
  discountId               String?
  discountName             String?
  discountRate             String? // e.g. "20%" or "₱50.00"
  discountVatExempt        Boolean       @default(false)
  // Split-out computation breakdown, persisted so a reprinted receipt can show
  // the exact original +/- derivation instead of reverse-engineering it later.
  vatableGross             Decimal       @default(0) @db.Decimal(10, 2)
  nonVatableGross          Decimal       @default(0) @db.Decimal(10, 2)
  vatableDiscountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  nonVatableDiscountAmount Decimal       @default(0) @db.Decimal(10, 2)
  vatRemovedFromVatable    Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount              Decimal       @db.Decimal(10, 2)
  paymentMethod            PaymentMethod
  cashReceived             Decimal?      @db.Decimal(10, 2)
  changeGiven              Decimal?      @db.Decimal(10, 2)
  // E-wallet payments: which wallet (GCash, Maya, ...) and its reference number,
  // so the cashier can match the sale to the transfer the store received.
  paymentProvider          String?
  paymentReference         String?
  insuranceClaim           Boolean       @default(false)
  copayAmount              Decimal?      @db.Decimal(10, 2)
  insurancePaid            Decimal?      @db.Decimal(10, 2)
  orderRemarks             String?
  status                   SaleStatus    @default(COMPLETED)
  saleDate                 DateTime      @default(now())
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  customerId               String?
  userId                   String
  prescriptionId           String?
  originalSaleId           String?
  shiftId                  String?
  // Set when an order taker prepared the order and a cashier completed it, so
  // both people are on record. Null for sales rung up start-to-finish by one user.
  orderTakerId             String?
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                    Store         @relation(fields: [storeId], references: [id])
  items                    SaleItem[]
  customer                 Customer?     @relation(fields: [customerId], references: [id])
  prescription             Prescription? @relation(fields: [prescriptionId], references: [id])
  user                     User          @relation("SaleCashier", fields: [userId], references: [id])
  orderTaker               User?         @relation("SaleOrderTaker", fields: [orderTakerId], references: [id])
  discount                 Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  pendingOrder             PendingOrder?
  originalSale             Sale?         @relation("SaleReturns", fields: [originalSaleId], references: [id])
  returns                  Sale[]        @relation("SaleReturns")
  shift                    Shift?        @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, saleNumber])
  @@index([tenantId, storeId, saleDate])
  @@index([shiftId])
  @@index([tenantId, paymentReference])
  @@map("sales")
}

// An order prepared by an order taker and waiting for a cashier to collect
// payment. Stock isn't reserved here — it's checked and deducted only when the
// cashier completes the sale, exactly like a normal checkout.
// A branch asking another branch for stock. Approving it performs a normal
// branch-to-branch transfer (same stock + batch movement), whose TR- reference
// is kept here so the request and the transfer can be traced to each other.
model StockRequest {
  id                String             @id @default(cuid())
  tenantId          String
  requestNumber     String
  fromStoreId       String // the branch asked to send the stock
  toStoreId         String // the branch that needs it
  items             Json // [{ productId, quantity }] as requested
  notes             String?
  status            StockRequestStatus @default(REQUESTED)
  requestedById     String
  handledById       String?
  handledAt         DateTime?
  decisionNote      String?
  transferReference String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromStore         Store              @relation("StockRequestFrom", fields: [fromStoreId], references: [id])
  toStore           Store              @relation("StockRequestTo", fields: [toStoreId], references: [id])
  requestedBy       User               @relation("StockRequestRequestedBy", fields: [requestedById], references: [id])
  handledBy         User?              @relation("StockRequestHandledBy", fields: [handledById], references: [id])

  @@unique([tenantId, requestNumber])
  @@index([tenantId, status])
  @@map("stock_requests")
}

model PendingOrder {
  id           String             @id @default(cuid())
  tenantId     String
  storeId      String
  orderNumber  String
  items        Json // [{ productId, quantity }]
  orderRemarks String?
  status       PendingOrderStatus @default(OPEN)
  createdById  String
  saleId       String?            @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store              @relation(fields: [storeId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
  sale         Sale?              @relation(fields: [saleId], references: [id])

  @@unique([tenantId, orderNumber])
  @@index([tenantId, storeId, status])
  @@map("pending_orders")
}

// A cashier's till session: opened with a declared starting cash float, closed
// with a counted ending cash amount. Optional — POS works without one, but
// starting one lets a shift-scoped reading (X-reading) and cash handover
// between cashiers, and closed shifts roll up into the daily closing report.
model Shift {
  id               String            @id @default(cuid())
  tenantId         String
  storeId          String
  userId           String
  startingCash     Decimal           @db.Decimal(10, 2)
  endingCash       Decimal?          @db.Decimal(10, 2)
  expectedCash     Decimal?          @db.Decimal(10, 2)
  notes            String?
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id])
  sales            Sale[]
  cashTransactions CashTransaction[]
  expenses         ShiftExpense[]

  @@index([tenantId, storeId, closedAt])
  @@index([userId, closedAt])
  @@map("shifts")
}

// Cash paid out of the drawer during a shift for a business expense (e.g.
// supplies, delivery fee) — distinct from CashTransaction (e-wallet/load
// services), which has its own reporting and shouldn't be conflated with
// this. Reduces the shift's expected cash-in-drawer by the same amount.
model ShiftExpense {
  id          String   @id @default(cuid())
  tenantId    String
  shiftId     String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("shift_expenses")
}

// GCash/Maya/etc "cash in / cash out" agent transactions, plus prepaid mobile
// load reselling — pharmacy services distinct from product sales. Cash-in:
// customer hands over physical cash, pharmacy credits the customer's e-wallet
// from its own float (drawer cash goes UP by the amount plus the service fee
// earned). Cash-out: customer's e-wallet is debited to the pharmacy's float,
// pharmacy hands over physical cash (drawer cash goes DOWN by the amount, net
// of the fee kept). Load: customer pays cash for prepaid mobile load sent to
// customerMobile (via GCash "Buy Load" or similar) — same direction as
// cash-in (drawer cash goes UP), provider holds the network name instead of
// an e-wallet brand. Tracked per-shift so it folds into the expected-cash
// reconciliation alongside sales.
model CashTransaction {
  id              String              @id @default(cuid())
  tenantId        String
  storeId         String
  shiftId         String?
  userId          String
  type            CashTransactionType
  provider        String // e.g. "GCash", "Maya", "PadalaXpress"
  amount          Decimal             @db.Decimal(10, 2)
  serviceFee      Decimal             @default(0) @db.Decimal(10, 2)
  referenceNumber String?
  customerName    String?
  customerMobile  String?
  createdAt       DateTime            @default(now())
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id])
  shift           Shift?              @relation(fields: [shiftId], references: [id])

  @@index([tenantId, storeId, createdAt])
  @@index([shiftId])
  @@map("cash_transactions")
}

enum CashTransactionType {
  CASH_IN
  CASH_OUT
  LOAD
}

model SaleItem {
  id               String  @id @default(cuid())
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)
  discountAmount   Decimal @default(0) @db.Decimal(10, 2)
  returnedQuantity Int     @default(0)
  saleId           String
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale             Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

